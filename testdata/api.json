{
  "openapi": "3.0.3",
  "info": { "title": "Fuzzy sample API", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com/{version}", "variables": { "version": { "default": "v1" } } }],
  "paths": {
    "/user/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 500 } }
      ],
      "get": {
        "operationId": "getUser",
        "summary": "Fetch a user",
        "parameters": [
          { "name": "fields", "in": "query", "schema": { "type": "array", "items": { "type": "string", "enum": ["name", "email", "age"] }, "minItems": 1, "uniqueItems": true }, "explode": false },
          { "name": "X-Request-Id", "in": "header", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "delete": {
        "operationId": "deleteUser",
        "parameters": [
          { "$ref": "#/components/parameters/Force" }
        ],
        "responses": { "204": { "description": "gone" } }
      }
    },
    "/user": {
      "post": {
        "operationId": "createUser",
        "summary": "Create a user",
        "requestBody": { "$ref": "#/components/requestBodies/NewUser" },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/search": {
      "get": {
        "operationId": "search",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2, "maxLength": 20 } },
          { "name": "ratio", "in": "query", "required": true, "schema": { "type": "number", "minimum": 0, "maximum": 1, "exclusiveMaximum": true } },
          { "name": "sku", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{4}$" } },
          { "name": "sort", "in": "query", "required": true, "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "object", "properties": { "size": { "type": "integer", "minimum": 1, "maximum": 50 }, "cursor": { "type": "string", "maxLength": 8 } }, "required": ["size"] }, "style": "deepObject" },
          { "name": "session", "in": "cookie", "schema": { "type": "string", "maxLength": 16 } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "kind"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "kind": { "type": "string", "enum": ["avatar", "document"] }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 3, "maxLength": 12 },
                  "password": { "type": "string", "format": "password", "minLength": 8, "maxLength": 32 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/legacy": {
      "post": {
        "operationId": "legacy",
        "requestBody": {
          "required": true,
          "content": { "application/xml": { "schema": { "type": "object" } } }
        },
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "components": {
    "parameters": {
      "Force": { "name": "force", "in": "query", "schema": { "type": "boolean" } }
    },
    "requestBodies": {
      "NewUser": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/NewUser" } }
        }
      }
    },
    "schemas": {
      "Base": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "email": { "type": "string", "format": "email" }
        }
      },
      "NewUser": {
        "allOf": [
          { "$ref": "#/components/schemas/Base" },
          {
            "type": "object",
            "required": ["age", "pet"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 30, "nullable": true },
              "age": { "type": "integer", "minimum": 18, "maximum": 120 },
              "score": { "type": "number", "multipleOf": 0.5, "minimum": 0, "maximum": 10 },
              "tags": { "type": "array", "items": { "type": "string", "maxLength": 5 }, "maxItems": 4 },
              "birthday": { "type": "string", "format": "date" },
              "pet": { "$ref": "#/components/schemas/Pet" },
              "manager": { "$ref": "#/components/schemas/Employee" }
            }
          }
        ]
      },
      "Pet": {
        "oneOf": [
          { "$ref": "#/components/schemas/Cat" },
          { "$ref": "#/components/schemas/Dog" }
        ],
        "discriminator": { "propertyName": "kind", "mapping": { "kitty": "#/components/schemas/Cat" } }
      },
      "Cat": { "type": "object", "required": ["kind", "lives"], "properties": { "kind": { "type": "string" }, "lives": { "type": "integer", "minimum": 1, "maximum": 9 } } },
      "Dog": { "type": "object", "required": ["kind", "bark"], "properties": { "kind": { "type": "string" }, "bark": { "type": "boolean" } } },
      "Employee": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 10 },
          "reports": { "type": "array", "items": { "$ref": "#/components/schemas/Employee" } }
        }
      }
    }
  }
}
